# Copie este archivo a .env y complete los valores. NUNCA suba .env al repositorio.
AZDO_ORG=https://dev.azure.com/interrapidisimo
AZDO_PROJECT=SitiosWeb
AZDO_PAT=
PORT=3000
MAX_CONCURRENT=3
# Repositorios que cada búsqueda procesa en paralelo
REPO_CONCURRENCY=3
DATA_DIR=./data

# Opcional: clave para cifrar el PAT guardado desde la UI y clave para administrarlo de forma remota
SECRET_KEY=
ADMIN_KEY=
